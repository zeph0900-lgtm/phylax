<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        Server picker pinned at the top so the user always knows which Frigate
        deployment the rest of this screen edits. The custom rounded layout
        marks the row as a distinct landing zone for the picker; the title is
        bound from ServerProfileStore in [ConnectionSettingsFragment].
    -->
    <Preference
        android:key="active_server"
        android:title="@string/server_title"
        android:layout="@layout/pref_server_row"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="@string/urls_title">

        <!--
            No `android:defaultValue` here on purpose: it would auto-persist
            onto a freshly-created (empty) server profile, defeating the wipe
            that `ServerProfileStore.applyToFlatState` does on profile switch.
        -->
        <EditTextPreference
            android:key="internal_url"
            android:icon="@drawable/ic_conn_internal"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/internal_url_title"
            android:summary="@string/internal_url_summary"
            android:inputType="textUri|textNoSuggestions"
            android:importantForAutofill="no" />

        <EditTextPreference
            android:key="external_url"
            android:icon="@drawable/ic_conn_external"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:summary="@string/external_url_summary"
            android:title="@string/external_url_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/network_mode_title">

        <ListPreference
            android:key="connection_mode"
            android:icon="@drawable/ic_conn_mode"
            android:title="@string/connection_mode_title"
            android:summary="@string/connection_mode_summary"
            android:entries="@array/connection_mode_entries"
            android:entryValues="@array/connection_mode_values"
            android:defaultValue="auto" />

        <Preference
            android:key="current_wifi_status"
            android:icon="@drawable/ic_conn_wifi"
            android:title="@string/current_status_title"
            android:summary="@string/checking_network_status" />

        <MultiSelectListPreference
            android:key="home_wifi_networks"
            android:icon="@drawable/ic_conn_wifi"
            android:title="@string/wifi_networks_title"
            android:summary="@string/wifi_networks_summary"
            android:dialogTitle="@string/wifi_networks_dialog" />

        <Preference
            android:key="add_home_network"
            android:icon="@drawable/ic_conn_wifi_add"
            android:title="@string/add_home_network_title"
            android:summary="@string/add_home_network_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/frigate_account_title">

        <EditTextPreference
            android:key="frigate_username"
            android:icon="@drawable/ic_conn_account"
            android:title="@string/username_title"
            android:summary="@string/username_summary"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true"
            android:autofillHints="username" />

        <EditTextPreference
            android:key="frigate_password"
            android:icon="@drawable/ic_conn_password"
            android:title="@string/password_title"
            android:summary="@string/password_summary"
            android:inputType="textPassword"
            android:singleLine="true"
            android:autofillHints="password" />

        <Preference
            android:key="client_cert_alias"
            android:icon="@drawable/ic_conn_cert"
            android:title="@string/client_certificate_title"
            android:summary="@string/not_selected" />

        <SwitchPreferenceCompat
            android:key="strict_tls_external"
            android:icon="@drawable/ic_conn_strict_tls"
            android:title="@string/strict_tls_title"
            android:summary="@string/strict_tls_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
