<?xml version="1.0" encoding="utf-8"?>
<!--
    Top-level Settings screen. Each preference navigates to its own fragment via the
    nav graph so back/up behave naturally (addToBackStack, slide animation, ActionBar
    up-arrow) instead of the old manual screenStack swap.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <Preference
        android:key="cat_connection"
        android:icon="@drawable/ic_settings_connection"
        android:title="@string/settings_connection_title"
        android:summary="@string/settings_connection_summary" />

    <Preference
        android:key="cat_notifications"
        android:icon="@drawable/ic_settings_notifications"
        android:title="@string/settings_notifications_title"
        android:summary="@string/settings_notifications_summary" />

    <Preference
        android:key="cat_quick_clip"
        android:icon="@drawable/ic_settings_downloads"
        android:title="快速下載片段"
        android:summary="選擇攝影機與任意開始、結束時間，直接下載 MP4" />

    <Preference
        android:key="cat_downloads"
        android:icon="@drawable/ic_settings_downloads"
        android:title="@string/settings_downloads_title"
        android:summary="@string/settings_downloads_summary" />

    <Preference
        android:key="cat_advanced"
        android:icon="@drawable/ic_settings_advanced"
        android:title="@string/settings_advanced_title"
        android:summary="@string/settings_advanced_summary" />

    <Preference
        android:key="cat_about"
        android:icon="@drawable/ic_settings_about"
        android:title="@string/settings_about_title"
        android:summary="@string/settings_about_summary" />

</PreferenceScreen>